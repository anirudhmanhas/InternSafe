{
  "name": "internsafe",
  "version": "0.4.0",
  "description": "InternSafe: checks internship and job offers for scam red flags",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "node tests/run-accuracy.js",
    "test:api": "node --test tests/api.test.js",
    "dev:client": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend install --include=dev && npm --prefix frontend run build"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0"
  }
}
